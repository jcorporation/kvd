/**
 * This file contains central definitions and is included in each source file
 * as first include. Some defines are configured by cmake.
 */

#ifndef KVD_COMPILE_TIME_H
#define KVD_COMPILE_TIME_H

// Version from cmake
#define KVD_VERSION "${PROJECT_VERSION}"

// Default configuration
#define LISTEN_URI "http://0.0.0.0:8091"
#define WORKDIR "/var/lib/kvd"

#define MAX_KEYS 1024
#define MAX_KEY_SIZE 1024
#define MAX_VALUE_SIZE 1048576
#define KVD_STORE_FILENAME "kvd_store.mpack"
#define KVD_STORE_VERSION 1

// Log level
#define LOGLEVEL_MIN 0
#define LOGLEVEL_MAX 7

#endif
